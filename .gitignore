# 의존성 — package.json 은 관리대장용이라 설치 결과물은 올리지 않는다
node_modules/

# 환경 변수·비밀값 — 절대 커밋 금지
.env
.env.*
*.pem
*.pfx
*.key

# 데이터 파일·출력 폴더 — 업무 데이터는 저장소에 올리지 않는다
*.xlsx
*.xls
*.xlsm
*.csv
*.tsv
out/
export/
tmp/

# 전처리 규칙 파일 — 실제 규칙은 SharePoint 에만 둔다. 스키마와 가짜 값 예시만 올린다
preprocess-rules.*.json
!schema/preprocess-rules.schema.json
!schema/preprocess-rules.example.json

# OS / 편집기
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
*.zip

# Claude Code 개인 설정 (.claude/settings.json 과 hooks 는 공유하므로 커밋)
.claude/settings.local.json

# 문서 — 로컬에서만 관리한다. 공개 저장소에 올리지 않는다
*.md
docs/
